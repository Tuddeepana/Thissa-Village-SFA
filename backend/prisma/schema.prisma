// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  CASHIER
  ADMIN
}

enum PaidStatus {
  PAID
  PENDING
}

enum ProductType {
  HANDMADE
  PURCHASE
}

enum TableType {
  VIP
  NORMAL
}

enum TableStatus {
  FREE
  OCCUPIED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  nic       String   @unique
  role      Role     @default(CASHIER) // admin, manager, cashier
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  products Product[]

  @@map("categories")
}

model Unit {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@map("units")
}

model RestaurantTable {
  id           String      @id @default(uuid())
  name         String      @unique
  table_type   TableType   @default(NORMAL)
  table_status TableStatus @default(FREE)
  quantity     Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  // Relations
  orders Order[]

  @@map("restaurant_tables")
}

model Product {
  id              String      @id @default(uuid())
  name            String
  description     String?
  barcode         String?
  unit_type       String?
  product_type    ProductType @default(PURCHASE)
  cost_price      Decimal     @db.Decimal(10, 2)
  foreigner_price Decimal     @db.Decimal(10, 2)
  local_price     Decimal     @db.Decimal(10, 2)
  low_stock       Int?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Inventory movements
  inventoryRecords Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Invoice {
  id          String     @id @default(uuid())
  in_number   String     @unique
  invoiceDate DateTime
  subtotal    Decimal    @default(0) @db.Decimal(10, 2)
  discount    Decimal    @default(0) @db.Decimal(10, 2)
  paid_status PaidStatus @default(PENDING)

  // Inventory movements
  inventoryRecords Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

model Inventory {
  id                 String  @id @default(uuid())
  productId          String
  invoiceId          String?
  billId             String?
  quantity_moved     Int
  available_quantity Int

  // Relations
  product Product  @relation(fields: [productId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  bill    Bill?    @relation(fields: [billId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory")
}

model Bill {
  id             String    @id @default(uuid())
  bill_number    String    @unique
  date           DateTime
  payment_method String
  customer_name  String?
  customer_phone String?
  total          Decimal   @db.Decimal(10, 2)
  subtotal       Decimal   @default(0) @db.Decimal(10, 2)
  cashier_name   String
  terminal_id    String?
  item_count     Int
  credit_note    String?
  cash_given     Decimal   @db.Decimal(10, 2)
  balance_given  Decimal   @db.Decimal(10, 2)
  tax            Decimal?  @db.Decimal(10, 2)
  discount       Decimal?  @default(0) @db.Decimal(10, 2)
  order_type     OrderType @default(TAKE_AWAY)
  table_number   Int?
  orderId        String?   @unique

  // Relations
  inventoryRecords Inventory[]
  order            Order?      @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bills")
}

model Order {
  id              String      @id @default(uuid())
  order_number    String      @unique
  customer_name   String
  customer_phone  String
  order_type      OrderType   @default(DINE_IN)
  status          OrderStatus @default(PREPARING)
  tableId         String?
  subtotal        Decimal     @default(0) @db.Decimal(10, 2)
  tax             Decimal     @default(0) @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @default(0) @db.Decimal(10, 2)
  terminal_id     String?
  cashier_name    String
  notes           String?

  // Relations
  table RestaurantTable? @relation(fields: [tableId], references: [id])
  items OrderItem[]
  bill  Bill?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  product_name String
  quantity     Int
  unit_price   Decimal @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_items")
}
