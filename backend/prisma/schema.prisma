// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CASHIER
  ADMIN
}

enum BottleVolume {
  L
  ML
}

enum PaidStatus {
  PAID
  PENDING
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  nic       String   @unique
  role      Role     @default(CASHIER) // admin, manager, cashier
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  products Product[]

  @@map("categories")
}

model Product {
  id            String       @id @default(uuid())
  name          String
  description   String?
  barcode       String?      @unique
  litres        Decimal      @db.Decimal(10, 2)
  cost_price    Decimal      @db.Decimal(10, 2)
  selling_price Decimal      @db.Decimal(10, 2)
  low_stock     Int
  bottle_volume BottleVolume @default(ML)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Inventory movements
  inventoryRecords Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Invoice {
  id          String     @id @default(uuid())
  in_number   String     @unique
  invoiceDate DateTime
  subtotal    Decimal    @default(0) @db.Decimal(10, 2)
  discount    Decimal    @default(0) @db.Decimal(10, 2)
  paid_status PaidStatus @default(PENDING)

  // Inventory movements
  inventoryRecords Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

model Inventory {
  id                 String  @id @default(uuid())
  productId          String
  invoiceId          String?
  billId             String?
  quantity_moved     Int
  available_quantity Int

  // Relations
  product Product  @relation(fields: [productId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  bill    Bill?    @relation(fields: [billId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory")
}

model Bill {
  id             String   @id @default(uuid())
  bill_number    String   @unique
  bill_seq       Int      @unique @default(autoincrement())
  date           DateTime
  payment_method String
  customer_name  String?
  total          Decimal  @db.Decimal(10, 2)
  cashier_name   String
  item_count     Int
  credit_note    String?
  cash_given     Decimal  @db.Decimal(10, 2)
  balance_given  Decimal  @db.Decimal(10, 2)
  tax            Decimal? @db.Decimal(10, 2)

  // Relations
  inventoryRecords Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bills")
}
