// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CASHIER
  ADMIN
}

enum PaidStatus {
  PAID
  PENDING
}

enum ProductType {
  HANDMADE
  PURCHASE
}

enum TableType {
  VIP
  NORMAL
}

enum RoomType {
  VIP
  NORMAL
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  nic       String   @unique
  role      Role     @default(CASHIER) // admin, manager, cashier
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  products Product[]

  @@map("categories")
}

model Unit {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@map("units")
}

model RestaurantTable {
  id         String    @id @default(uuid())
  name       String    @unique
  table_type TableType @default(NORMAL)
  quantity   Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@map("restaurant_tables")
}

model Room {
  id              String    @id @default(uuid())
  name            String    @unique
  room_type       RoomType  @default(NORMAL)
  quantity        Int       @default(1)
  price_full_day  Decimal   @default(0) @db.Decimal(10, 2)
  price_short_time Decimal  @default(0) @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  bookedRooms BookedRoom[]

  @@map("rooms")
}

model RoomBooking {
  id              String   @id @default(uuid())
  customerName    String
  customerNic     String?
  customerPhone   String
  customerAddress String?
  checkInDate     DateTime
  checkOutDate    DateTime
  totalAmount     Decimal  @db.Decimal(10, 2)
  status          String   @default("ACTIVE") // ACTIVE, CHECKED_OUT, CANCELLED
  cashierName     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  bookedRooms BookedRoom[]

  @@map("room_bookings")
}

model BookedRoom {
  id            String   @id @default(uuid())
  bookingId     String
  roomId        String
  roomName      String // Store room display name like "Room 1"
  pricePerNight Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  // Relations
  booking RoomBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    Room        @relation(fields: [roomId], references: [id])

  @@map("booked_rooms")
}

model Product {
  id              String      @id @default(uuid())
  name            String
  description     String?
  barcode         String?
  unit_type       String?
  product_type    ProductType @default(PURCHASE)
  cost_price      Decimal     @db.Decimal(10, 2)
  foreigner_price Decimal     @db.Decimal(10, 2)
  local_price     Decimal     @db.Decimal(10, 2)
  low_stock       Int?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Inventory movements
  inventoryRecords Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Invoice {
  id          String     @id @default(uuid())
  in_number   String     @unique
  invoiceDate DateTime
  subtotal    Decimal    @default(0) @db.Decimal(10, 2)
  discount    Decimal    @default(0) @db.Decimal(10, 2)
  paid_status PaidStatus @default(PENDING)

  // Inventory movements
  inventoryRecords Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

model Inventory {
  id                 String  @id @default(uuid())
  productId          String
  invoiceId          String?
  billId             String?
  quantity_moved     Int
  available_quantity Int

  // Relations
  product Product  @relation(fields: [productId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  bill    Bill?    @relation(fields: [billId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory")
}

model Bill {
  id             String   @id @default(uuid())
  bill_seq       Int      @unique @default(autoincrement())
  bill_number    String   @unique
  date           DateTime
  payment_method String
  customer_name  String?
  customer_type  String?  @default("local")
  service_charge_percentage Decimal? @db.Decimal(5, 2)
  service_charge_amount     Decimal? @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  cashier_name   String
  item_count     Int
  credit_note    String?
  cash_given     Decimal  @db.Decimal(10, 2)
  balance_given  Decimal  @db.Decimal(10, 2)
  tax            Decimal? @db.Decimal(10, 2)

  // Relations
  inventoryRecords Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bills")
}

model ExpenseType {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  expenses Expense[]

  @@map("expense_types")
}

model Expense {
  id            String   @id @default(uuid())
  amount        Decimal  @db.Decimal(10, 2)
  description   String?
  date          DateTime
  expenseTypeId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  expenseType ExpenseType @relation(fields: [expenseTypeId], references: [id])

  @@map("expenses")
}

model ServiceCharge {
  id         String   @id @default("default")
  percentage Decimal  @default(0) @db.Decimal(5, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("service_charges")
}


enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
}

model Order {
  id             String      @id @default(uuid())
  order_number   String      @unique
  customer_name  String
  customer_phone String
  customer_type  String      @default("local")
  order_type     OrderType
  table_id       String?
  table_name     String?
  table_number   Int?
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  tax            Decimal     @default(0) @db.Decimal(10, 2)
  discount       Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  terminal_id    String
  cashier_name   String
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  product_name String
  quantity     Int
  unit_price   Decimal @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

enum PrinterType {
  KOT
}

model Printer {
  id           String      @id @default(uuid())
  name         String
  ipAddress    String      @map("ip_address")
  port         Int         @default(9100)
  type         PrinterType @default(KOT)
  isActive     Boolean     @default(true) @map("is_active")
  lastTestedAt DateTime?   @map("last_tested_at")
  lastTestOk   Boolean     @default(false) @map("last_test_ok")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("printers")
}
